from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import GatewayUser, get_current_user
from app.config.database import get_db
from app.crud.studies import get_study
from app.models.study_access import StudyAccess
from app.schemas.study_access import StudyAccessCreate, StudyAccessBulkCreate, StudyAccessResponse

router = APIRouter()


@router.post("/studies/{study_id}/access", response_model=list[StudyAccessResponse], status_code=status.HTTP_201_CREATED)
async def add_study_access(
    study_id: str,
    data: StudyAccessBulkCreate,
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    """Grant study access to one or more users at once."""
    study = await get_study(db, study_id)
    if not study:
        raise HTTPException(status_code=404, detail="Study not found")

    records = []
    for user_id in data.user_ids:
        access = StudyAccess(study_id=study_id, user_id=user_id, status=data.status, created_by=user.user_id)
        db.add(access)
        records.append(access)

    await db.flush()
    for r in records:
        await db.refresh(r)

    return records
