EXCLUDED_STATUSES = ("deleted", "archived")


@router.get("/studies", response_model=list[StudyResponse])
async def list_studies(
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    """
    List studies based on user role:
    - admin: all active studies
    - others: studies they have access to or created
      (or all active studies if they have no access rows yet)
    """
    # NOT IN skips rows where status is NULL, so allow NULL on purpose
    is_active = or_(Study.status.is_(None), Study.status.notin_(EXCLUDED_STATUSES))

    if user.is_admin:
        result = await db.execute(select(Study).where(is_active))
        return result.scalars().all()

    has_access_rows = await db.scalar(
        select(exists().where(StudyAccess.user_id == user.user_id))
    )

    # No access rows for this user yet: keep the old "show everything" behavior
    if not has_access_rows:
        result = await db.execute(select(Study).where(is_active))
        return result.scalars().all()

    shared_with_user = Study.uuid.in_(
        select(StudyAccess.study_id).where(StudyAccess.user_id == user.user_id)
    )
    result = await db.execute(
        select(Study).where(
            is_active,
            or_(shared_with_user, Study.created_by == user.user_id),
        )
    )
    return result.scalars().all()
