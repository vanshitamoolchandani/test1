from uuid import UUID

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import GatewayUser, get_current_user
from app.config.database import get_db
from app.crud.studies import create_study, get_study, update_study
from app.models.studies import Study
from app.models.study_access import StudyAccess
from app.schemas.studies import StudyCreate, StudyResponse, StudyUpdate

router = APIRouter()


@router.post("/studies", response_model=StudyResponse, status_code=status.HTTP_201_CREATED)
async def create_study_endpoint(
    data: StudyCreate,
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    print("HIT POST /studies", data, flush = True)
    data.created_by = user.user_id
    study = await create_study(db, data)
    return study


@router.get("/studies/{study_uuid}", response_model=StudyResponse)
async def get_study_endpoint(
    study_uuid: UUID,
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    study = await get_study(db, str(study_uuid))
    if not study:
        raise HTTPException(status_code=404, detail="Study not found")
    return study


@router.put("/studies/{study_uuid}", response_model=StudyResponse)
async def update_study_endpoint(
    study_uuid: UUID,
    data: StudyUpdate,
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    """Update study details. Only provided fields will be updated."""
    study = await update_study(db, str(study_uuid), data)
    if not study:
        raise HTTPException(status_code=404, detail="Study not found")
    return study


@router.get("/studies", response_model=list[StudyResponse])
async def list_studies(
    
    user: GatewayUser = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):  
    all_studies_result = await db.execute(select(Study))
    all_studies = all_studies_result.scalars().all()
    print("ALL STUDIES:", [s.study_id for s in all_studies], flush=True)
    print("STATUSES:", [(s.study_id, s.status) for s in all_studies], flush=True)
    """
    List studies based on user role:
    - admin: returns all studies (excluding deleted/archived)
    - others: returns studies the user has access to, OR all if no access control is set up
    """
    # Exclude only explicitly inactive statuses
    excluded_statuses = ("deleted", "archived")

    if user.is_admin:
        result = await db.execute(
            select(Study).where(Study.status.notin_(excluded_statuses))
        )
    else:
        # Check if study_access table has any records for this user
        access_result = await db.execute(
            select(Study)
            .join(StudyAccess, StudyAccess.study_id == Study.uuid)
            .where(StudyAccess.user_id == user.user_id, Study.status.notin_(excluded_statuses))
        )
        studies = access_result.scalars().all()

        # If no access records found, fall back to returning all active studies
        # (handles case where access control isn't configured yet)
        if not studies:
            result = await db.execute(
                select(Study).where(Study.status.notin_(excluded_statuses))
            )
            studies = result.scalars().all()

        return studies

    return result.scalars().all()
